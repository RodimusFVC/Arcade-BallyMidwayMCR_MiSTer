<misterromdescription>
    <name>Discs Of Tron</name>
    <region>US</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version>Upright, 10/4/83</version>
    <alternative></alternative>
    <platform></platform>
    <series>Tron</series>
    <year>1983</year>
    <manufacturer>Bally Midway</manufacturer>
    <category>Shooter</category>

    <setname>dotron</setname>
    <parent>dotron</parent>
    <mameversion>0289</mameversion>
    <rbf>BallyMidwayMCR</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>horizontal</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way + spinner (throw): mouse X, left analog stick or D-pad</joystick>
    <special_controls></special_controls>
    <num_buttons>4</num_buttons>
    <buttons names="Button 1,Button 2,Aim Down,Aim Up,Coin,Start 1P,Start 2P,Pause,-,-,-,-" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="FF,FF">
        <dip name="Cabinet" bits="7" ids="Environmental,Upright"/>
        <dip name="Coin Meters" bits="8" ids="2,1"/>
    </switches>

