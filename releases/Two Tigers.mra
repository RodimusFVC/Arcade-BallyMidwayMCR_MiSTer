<misterromdescription>
    <name>Two Tigers</name>
    <region>US</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version>Dedicated</version>
    <alternative></alternative>
    <platform></platform>
    <series></series>
    <year>1984</year>
    <manufacturer>Bally Midway</manufacturer>
    <category>Shooter</category>

    <setname>twotiger</setname>
    <parent>twotiger</parent>
    <mameversion>0289</mameversion>
    <rbf>BallyMidwayMCR</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>horizontal</rotation>
    <flip>yes</flip>

    <players>2 (simultaneous)</players>
    <joystick>analog stick X (one per player)</joystick>
    <special_controls></special_controls>
    <num_buttons>4</num_buttons>
    <buttons names="Button 1,Button 2,Button 3,-,Coin,Start 1P,Start 2P,Pause,Dogfight Start,-,-,-" default="A,B,X,Select,Start,R,L,Y"/>

    <switches default="FC">
        <dip name="Shot Speed" bits="0" ids="Slow,Fast"/>
        <dip name="Dogfight" bits="1" ids="1 Credit,2 Credits"/>
    </switches>

    <!-- Index 0: main CPU 0x00000, SSIO 0x10000, lamp PROM 0x14000, SSIO PROM 0x14040, background 0x18000, sprites 0x20000,
         Squawk n Talk / Turbo Cheap Squeak 0x40000 (layout in tools/make_mra.py). Generated by tools/make_mra.py -->
