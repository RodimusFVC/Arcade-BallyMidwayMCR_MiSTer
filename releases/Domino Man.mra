<misterromdescription>
    <name>Domino Man</name>
    <region>US</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version>Set 1</version>
    <alternative></alternative>
    <platform></platform>
    <series></series>
    <year>1982</year>
    <manufacturer>Bally Midway</manufacturer>
    <category>Action</category>

    <setname>domino</setname>
    <parent>domino</parent>
    <mameversion>0289</mameversion>
    <rbf>BallyMidwayMCR</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>horizontal</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Button 1,-,-,-,Coin,Start 1P,Start 2P,Pause,-,-,-,-" default="A,Select,Start,R,L"/>

    <switches default="3E">
        <dip name="Music" bits="0" ids="On,Off"/>
        <dip name="Skin Color" bits="1" ids="Dark,Light"/>
        <dip name="Cabinet" bits="6" ids="Upright,Cocktail"/>
        <dip name="Coin Meters" bits="7" ids="2,1"/>
    </switches>

