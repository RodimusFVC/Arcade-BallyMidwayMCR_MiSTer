<misterromdescription>
    <name>Demolition Derby</name>
    <region>US</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series></series>
    <year>1984</year>
    <manufacturer>Bally Midway</manufacturer>
    <category>Driving</category>

    <setname>demoderb</setname>
    <parent>demoderb</parent>
    <mameversion>0289</mameversion>
    <rbf>BallyMidwayMCR</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>horizontal</rotation>
    <flip>yes</flip>

    <players>4 (simultaneous)</players>
    <joystick>steering wheel: mouse X, left analog stick or D-pad</joystick>
    <special_controls></special_controls>
    <num_buttons>2</num_buttons>
    <buttons names="Button 1,Button 2,-,-,Coin,Start 1P,Start 2P,Pause,-,-,-,-" default="A,B,Select,Start,R,L"/>

    <switches default="FF">
        <dip name="Cabinet" bits="0" ids="4P Cocktail,2P Upright"/>
        <dip name="Difficulty" bits="1" ids="Harder,Normal"/>
        <dip name="Free Play" bits="2" ids="On,Off"/>
        <dip name="Reward Screen" bits="3" ids="Limited,Expanded"/>
        <dip name="Coinage" bits="4,5" ids="2 Coins/2 Credits,1 Coin/2 Credits,2 Coins/1 Credit,1 Coin/1 Credit"/>
    </switches>

    <!-- Index 0: main CPU 0x00000, SSIO 0x10000, lamp PROM 0x14000, SSIO PROM 0x14040, background 0x18000, sprites 0x20000,
         Squawk n Talk / Turbo Cheap Squeak 0x40000 (layout in tools/make_mra.py). Generated by tools/make_mra.py -->
