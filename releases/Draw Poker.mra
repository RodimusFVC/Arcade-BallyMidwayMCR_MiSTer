        <dip name="Unused" bits="4" ids="Off,On"/>
        <dip name="Cards After 5th Coin" bits="5" ids="Logo Up,Face Up"/>
        <dip name="Currency" bits="6" ids="Other Coins,Ike Dollars"/>
        <dip name="Background Color" bits="7" ids="Blue,Green"/>
    </switches>

