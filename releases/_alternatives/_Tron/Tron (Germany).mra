<misterromdescription>
    <name>Tron (Germany)</name>
    <region>Germany</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Tron</series>
    <year>1982</year>
    <manufacturer>Bally Midway</manufacturer>
    <category>Action</category>

    <setname>tronger</setname>
    <parent>tron</parent>
    <mameversion>0289</mameversion>
    <rbf>BallyMidwayMCR</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way + spinner (aim): mouse X, left analog stick or D-pad</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Button 1,-,-,-,Coin,Start 1P,Start 2P,Pause,-,-,-,-" default="A,Select,Start,R,L"/>

    <switches default="00">
        <dip name="Coin Meters" bits="0" ids="2,1"/>
        <dip name="Cabinet" bits="1" ids="Upright,Cocktail"/>
        <dip name="Allow Continue" bits="2" ids="Yes,No"/>
    </switches>

