<misterromdescription>
    <name>Solar Fox</name>
    <region>US</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version>Upright</version>
    <alternative></alternative>
    <platform></platform>
    <series></series>
    <year>1981</year>
    <manufacturer>Bally Midway</manufacturer>
    <category>Shooter</category>

    <setname>solarfox</setname>
    <parent>solarfox</parent>
    <mameversion>0289</mameversion>
    <rbf>BallyMidwayMCR</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>2</num_buttons>
    <buttons names="Button 1,Button 2,-,-,Coin,-,-,Pause,-,-,-,-" default="A,B,Select,L"/>

    <switches default="EF">
        <dip name="Bonus" bits="0,1" ids="Unused,After 20 racks,None,After 10 racks"/>
        <dip name="Demo Sounds" bits="4" ids="On,Off"/>
        <dip name="Ignore Hardware Failure" bits="6" ids="On,Off"/>
        <dip name="Cabinet" bits="7" ids="Cocktail,Upright"/>
    </switches>

